            <group id="noindex_nofollow" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>NOINDEX,NOFOLLOW Configuration</label>
                <comment>
                    <![CDATA[Configure URLs that should be set to NOINDEX,NOFOLLOW. These pages won't be indexed and search engines won't follow links on them.]]></comment>

                <field id="url_paths" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>URL Paths</label>
                    <comment><![CDATA[Enter one URL path per line in format /path/ (e.g., /checkout/, /customer/). Trailing slash will be added automatically if missing.]]></comment>
                    <backend_model>CyberSolutionsLLC\RobotsExtended\Model\Config\Backend\UrlPaths</backend_model>
                    <depends>
                        <field id="robots_extended/general/enabled">1</field>
                    </depends>
                </field>
            </group>
