        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="cybersolutionsllc" translate="label" sortOrder="0">
            <label>CyberSolutions LLC</label>
        </tab>
        <section id="robots_extended" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Robots Meta Tags Extended</label>
