<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">cerakote_production_report.cerakote_production_report_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>cerakote_production_report_columns</spinner>
        <deps>
            <dep>cerakote_production_report.cerakote_production_report_data_source</dep>
        </deps>
    </settings>
    <dataSource name="cerakote_production_report_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>CyberSolutionsLLC_CerakoteReport::cerakote_production_report</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="cerakote_production_report_data_source">
            <settings>
                <requestFieldName>item_id</requestFieldName>
                <primaryFieldName>item_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <paging name="listing_paging"/>
        <filters name="listing_filters"/>
    </listingToolbar>
    <columns name="cerakote_production_report_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>item_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="cerakote_color">
            <settings>
                <filter>text</filter>
                <label translate="true">Cerakote Color</label>
            </settings>
        </column>
        <column name="order_date" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Order Date</label>
            </settings>
        </column>
        <column name="product_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Product Name</label>
            </settings>
        </column>
        <column name="sku">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU</label>
            </settings>
        </column>
        <column name="qty">
            <settings>
                <filter>text</filter>
                <dataType>number</dataType>
                <label translate="true">Quantity</label>
            </settings>
        </column>
    </columns>
</listing>