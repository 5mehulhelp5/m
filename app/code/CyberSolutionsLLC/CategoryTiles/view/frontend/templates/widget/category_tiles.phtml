<?php
/** @var \CyberSolutionsLLC\CategoryTiles\Block\Widget\CategoryTiles $block */
$tiles = $block->getTiles();
if (empty($tiles)) {
    return;
}
$heading = $block->escapeHtml($block->getHeading());
?>
<div class="category-tiles-widget">
    <h2 class="category-tiles-heading"><?= $heading ?></h2>
    <div class="category-tiles-container">
        <?php foreach ($tiles as $tile): ?>
            <a href="<?= $block->escapeUrl($tile['url']) ?>" class="category-tile" title="<?= $block->escapeHtmlAttr($tile['text']) ?>">
                <div class="category-tile-image" style="background-image: url('<?= $block->escapeUrl($tile['image_url']) ?>')"></div>
                <span class="category-tile-label"><?= $block->escapeHtml($tile['text']) ?></span>
            </a>
        <?php endforeach; ?>
    </div>
</div>
