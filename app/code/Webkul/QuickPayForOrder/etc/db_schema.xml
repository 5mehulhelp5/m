<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="quickpayorder_history" resource="default" engine="innodb">
    <column xsi:type="int" name="entity_id" padding="11" unsigned="false" nullable="false" identity="true"/>
    <column xsi:type="int" name="quote_id" padding="11" unsigned="false" nullable="false" identity="false"/>
    <column xsi:type="int" name="customer_id" padding="11" unsigned="false" nullable="false" identity="false"/>
    <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true"/>
    <column xsi:type="int" name="order_id" padding="11" unsigned="false" nullable="true" identity="false"/>
    <column xsi:type="int" name="order_status" padding="11" unsigned="false" nullable="false" identity="false" default="0"/>
    <column xsi:type="text" name="attachment" nullable="true"/>
    <column xsi:type="text" name="payment_methods" nullable="true"/>
    <column xsi:type="text" name="shipping_method" nullable="true"/>
    <column xsi:type="int" name="all_payment_methods" padding="11" unsigned="false" identity="false" nullable="false" default="0"/>
    <column xsi:type="int" name="all_shipping_methods" padding="11" unsigned="false" identity="false" nullable="false" default="0"/>
    <column xsi:type="varchar" name="quote_currency_code" nullable="true" length="255"
            comment="Quote Currency Code"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="entity_id"/>
    </constraint>
  </table>
</schema>
