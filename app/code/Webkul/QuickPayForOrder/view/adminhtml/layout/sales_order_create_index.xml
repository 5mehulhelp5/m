        </referenceBlock>
        <referenceBlock name="order_create_billing_form">
            <action method="setTemplate">
                <argument translate="true" name="template" xsi:type="string">Webkul_QuickPayForOrder::order/create/billing/method/form.phtml</argument>
            </action>
        </referenceBlock>
