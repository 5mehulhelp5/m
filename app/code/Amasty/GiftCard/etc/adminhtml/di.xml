<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Controller\Adminhtml\Product\Initialization\Helper">
        <plugin name="amgcardProductInitializationPlugin" type="Amasty\GiftCard\Plugin\Catalog\Controller\Adminhtml\Product\Initialization\InitializationHelperPlugin" sortOrder="120"/>
    </type>
    <type name="Magento\Sales\Block\Adminhtml\Order\View">
        <plugin name="amGiftCardLowCodeQtyNotification" type="Amasty\GiftCard\Plugin\Order\View\CodePoolNotification" />
    </type>
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="amGiftCard" xsi:type="array">
                    <item name="class" xsi:type="string">Amasty\GiftCard\Model\GiftCard\DataProvider\Product\Form\Modifier\GiftCard</item>
                    <item name="sortOrder" xsi:type="number">90</item>
                </item>
                <item name="amGiftCardUsage" xsi:type="array">
                    <item name="class" xsi:type="string">Amasty\GiftCard\Model\GiftCard\DataProvider\Product\Form\Modifier\Usage</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\CatalogStaging\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="amGiftCard" xsi:type="array">
                    <item name="class" xsi:type="string">Amasty\GiftCard\Model\GiftCard\DataProvider\Product\Form\Modifier\GiftCard</item>
                    <item name="sortOrder" xsi:type="number">90</item>
                </item>
                <item name="amGiftCardUsage" xsi:type="array">
                    <item name="class" xsi:type="string">Amasty\GiftCard\Model\GiftCard\DataProvider\Product\Form\Modifier\Usage</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Amasty_GiftCardRateLimiter" type="Amasty\Base\Block\Adminhtml\System\Config\Form\Fieldset\PromoFieldset">
        <arguments>
            <argument name="moduleName" xsi:type="string">Amasty_GiftCardRateLimiter</argument>
            <argument name="promoConfig" xsi:type="array">
                <item name="planType" xsi:type="string">subscribe</item>
                <item name="infoMessage" xsi:type="string"><![CDATA[The functionality is available as part of an active product subscription or support subscription for the Gift Card module. To upgrade and obtain functionality please follow the <a href='https://amasty.com/amcustomer/account/products/?utm_source=extension&utm_medium=backend&utm_campaign=subscribe_giftcard' target='_blank'>link</a>. Then, you can find the 'amasty/module-gift-card-rate-limiter' package for installation in composer suggest]]></item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Amasty_GiftCardSubscriptionFunctionality" type="Amasty\Base\Block\Adminhtml\System\Config\Form\Field\Promo\PromoField">
        <arguments>
            <argument name="moduleName" xsi:type="string">Amasty_GiftCardSubscriptionFunctionality</argument>
            <argument name="promoConfig" xsi:type="array">
                <item name="promoLink" xsi:type="string"><![CDATA[https://amasty.com/amcustomer/account/products/?utm_source=extension&utm_medium=backend&utm_campaign=subscribe_giftcard]]></item>
                <item name="comment" xsi:type="string"><![CDATA[The functionality is available as part of an active product subscription or support subscription for the Gift Card module. To upgrade and obtain functionality, please follow the <a href='https://amasty.com/amcustomer/account/products/?utm_source=extension&utm_medium=backend&utm_campaign=subscribe_giftcard' target='_blank'>link</a>. Then you can find the 'amasty/module-gift-card-subscription-functionality' package for installation in composer suggest.]]></item>
            </argument>
        </arguments>
    </virtualType>
</config>
