<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="amgiftcard_sms_notify_expired_cards" instance="Amasty\GiftCardSmsNotifications\Cron\NotifyCardsExpiration" method="execute">
            <schedule>0 22 * * *</schedule>
        </job>
    </group>
</config>
